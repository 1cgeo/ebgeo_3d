{
  "name": "ebgeo-3d-service",
  "version": "1.0.0",
  "description": "3D tileset service for EBGeo",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "importar": "node --env-file-if-exists=.env scripts/importar.js",
    "verificar": "node --env-file-if-exists=.env scripts/verificar.js",
    "catalogo": "node --env-file-if-exists=.env scripts/catalogo.js",
    "cleanup-wal": "node --env-file-if-exists=.env scripts/cleanup-wal.js",
    "test": "node --test tests/*.test.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "bench": "node --expose-gc bench/banco.js",
    "bench:http": "node bench/http.js",
    "bench:cliente": "node bench/cliente.js",
    "importar:glb": "node --env-file-if-exists=.env scripts/importar-glb.js",
    "metadados": "node --env-file-if-exists=.env scripts/metadados.js",
    "remedir": "node --env-file-if-exists=.env scripts/remedir.js",
    "importar:cena": "node --env-file-if-exists=.env scripts/importar-cena.js"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^10.1.3",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "better-sqlite3": "^12.11.1",
    "draco3dgltf": "^1.5.7",
    "fastify": "^5.2.1",
    "meshoptimizer": "^1.2.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "globals": "^15.15.0",
    "knip": "^5.83.1"
  },
  "author": "1º Centro de Geoinformação",
  "license": "ISC",
  "engines": {
    "node": ">=22.0.0"
  }
}
