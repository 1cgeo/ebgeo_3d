# Copie para .env e ajuste. O `npm start` le este arquivo por --env-file.

# ---- servico ----
PORT=8082
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=*

# Diretorio dos dados servidos: index.db, models/*.3dtiles, assets/
EBGEO3D_DATA_DIR=./data

# Arvore de origem dos modelos, montada :ro no container. So a importacao usa.
# Sem ela o docker-compose monta ./origem, que nao existe.
EBGEO3D_SOURCE_DIR=D:/modelos_3d

# ---- limites de memoria ----
# Bancos de modelo abertos ao mesmo tempo (LRU). O produto com MODEL_CACHE_SIZE_KB
# e o que precisa caber no container: 12 x 8 MB = 96 MB.
MAX_OPEN_MODELS=12
MODEL_CACHE_SIZE_KB=-8000
MODEL_MMAP_BYTES=67108864
MAX_INFLIGHT_TILES=64

# ---- importacao (so os scripts usam) ----
# Caminho do executavel `ktx` do KTX-Software 4.4+.
# Windows: C:/Program Files/KTX-Software/bin/ktx.exe
# Linux e o container: ktx (esta no PATH)
KTX_BIN=ktx
